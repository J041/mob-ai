{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rationale": { "type": "string" },
    "evidence_used": {
      "type": "array",
      "items": { "type": "string" }
    },
    "added": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "library": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason": { "type": "string" },
          "cross_abi": {
            "type": ["object", "null"],
            "properties": {
              "abis": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "reason": { "type": "string" }
            },
            "required": ["abis", "reason"],
            "additionalProperties": false
          }
        },
        "required": ["library", "priority", "reason", "cross_abi"],
        "additionalProperties": false
      }
    }
  },
  "required": ["rationale", "evidence_used", "added"],
  "additionalProperties": false
}
