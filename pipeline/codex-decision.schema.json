{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["updated", "no_change", "diagnostics", "human_review"]
    },
    "rationale": {
      "type": "string"
    },
    "changes_made": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_used": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remaining_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diagnostic_actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "trace_jni_registration",
          "capture_native_exceptions",
          "trace_termination_calls",
          "inventory_executable_mappings",
          "dump_runtime_payloads",
          "compare_launch_modes",
          "late_attach_observer",
          "snapshot_process_mappings",
          "dump_new_executable_regions",
          "trace_dynamic_loading",
          "trace_signal_handlers",
          "capture_runtime_dex",
          "extract_embedded_payload"
        ]
      }
    }
  },
  "required": [
    "decision",
    "rationale",
    "changes_made",
    "evidence_used",
    "remaining_risks",
    "diagnostic_actions"
  ],
  "additionalProperties": false
}
