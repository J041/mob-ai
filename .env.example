# Copy to .env before starting the stack. Connect Codex or Claude from the web UI.
MOB_AI_UI_PORT=8787
MOB_AI_MAX_UPLOAD_MB=1024
# Curated Frida clients installed into the web and worker images. The UI can
# select either version; upload the exact matching frida-server for the device ABI.
FRIDA_VERSION=17.25.0
FRIDA_COMPAT_VERSION=16.7.19
FRIDA_COMPAT_TOOLS_VERSION=13.5.0
FRIDA_TOOLS_VERSION=14.11.0
# Optional override for the internal web-to-Ghidra bearer token.
GHIDRA_MCP_AUTH_TOKEN=mob-ai-private-compose-token
